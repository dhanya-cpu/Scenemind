# SceneMind AI - Environment Configuration

# Application
APP_NAME=SceneMind AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scenemind
POSTGRES_PASSWORD=scenemind_secret
POSTGRES_DB=scenemind_db
DATABASE_URL=postgresql+asyncpg://scenemind:scenemind_secret@localhost:5432/scenemind_db

# Redis (caching & pub/sub)
REDIS_URL=redis://localhost:6379/0

# MQTT (Digital Twin streaming)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=scenemind

# ROS2
ROS_DOMAIN_ID=0
ROS_NAMESPACE=/scenemind

# Computer Vision
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.5
CAMERA_DEVICE=0
VISION_FPS=30

# Vision Language Model
VLM_MODEL=florence-2-base
VLM_ENABLED=false

# LLM Reasoning (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
REASONING_ENABLED=true

# Voice
WHISPER_MODEL=base
PIPER_VOICE=en_US-lessac-medium
VOICE_ENABLED=true
TTS_OUTPUT_DIR=./data/tts

# Navigation
SLAM_ENABLED=true
NAV2_ENABLED=true
MAP_RESOLUTION=0.05

# Digital Twin (NVIDIA Omniverse)
OMNIVERSE_HOST=localhost
OMNIVERSE_PORT=8211
DIGITAL_TWIN_ENABLED=false

# Isaac Sim
ISAAC_SIM_HOST=localhost
ISAAC_SIM_PORT=8211
SIMULATION_MODE=true

# Grafana
GRAFANA_URL=http://localhost:3001

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
